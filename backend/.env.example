# PostgreSQL connection string
DATABASE_URL="postgresql://kasrevent:kasrevent@localhost:5432/kasrevent?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=12

# Public base URL used when embedding links inside generated QR codes / guest invitation links
PUBLIC_APP_URL="http://localhost:5173"
