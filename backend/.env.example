# PostgreSQL connection string
DATABASE_URL="postgresql://kasrevent:kasrevent@localhost:5432/kasrevent?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=12

# Public base URL used when embedding links inside generated QR codes / guest invitation links
PUBLIC_APP_URL="http://localhost:5173"

# Licensing — required to activate a paying customer's account after a one-time fee is paid
# (see POST /auth/activate). Set a UNIQUE value per customer deployment so one leaked secret
# can't activate another customer's copy of the app. Leave unset locally to disable activation.
ACTIVATION_SECRET=""

# Seed script: whether the seeded admin/gérant accounts start pre-activated. Leave false (or
# unset) for a real customer deployment so they must pay before their account is usable;
# set to "true" for your own dev/demo instances.
SEED_ADMIN_ACTIVE="false"
