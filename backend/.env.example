# PostgreSQL connection string
DATABASE_URL="postgresql://kasrevent:kasrevent@localhost:5432/kasrevent?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=12

# Public base URL used when embedding links inside generated QR codes / guest invitation links
PUBLIC_APP_URL="http://localhost:5173"

# Licensing — required to activate a paying customer's account after a one-time fee is paid
# (see POST /auth/activate). Set a UNIQUE value per customer deployment so one leaked secret
# can't activate another customer's copy of the app. Leave unset locally to disable activation.
ACTIVATION_SECRET=""

# Seed script: whether the seeded DEMO business's admin/gérant accounts start pre-activated.
# Leave false (or unset) so they must go through the activation link like a real customer;
# set to "true" for your own dev/demo instances.
SEED_ADMIN_ACTIVE="false"

# Seed script: the app's own Super Admin operator accounts — used to onboard every new paying
# business via POST /businesses. Always active (no license fee for the operators themselves).
SUPERADMIN_1_EMAIL="owner1@kasrevent.local"
SUPERADMIN_2_EMAIL="owner2@kasrevent.local"
SUPERADMIN_PASSWORD="change-me"
